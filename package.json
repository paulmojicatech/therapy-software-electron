{
  "name": "therapy-software",
  "version": "1.0.0",
  "author": "Paul Mojica Technologies",
  "description": "Therapy Software",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "start-nest-js": "cd ../../nest-js-therapy-software-api/therapy-software-api && npm start",
    "electron": "ng build --base-href ./ && electron .",
    "package-win": "ng build --configuration production --base-href ./ && electron-packager . --overwrite --platform=win32 --arch=x64 --prune=true --out=release-builds",
    "package-mac": "ng build --configuration production --base-href ./ && electron-packager . --overwrite --platform=darwin --arch=x64 --prune=true --out=release-builds --electron-version=3.0.7"
  },
  "main": "main.js",
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.7",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^18.2.7",
    "@angular/compiler": "^18.2.7",
    "@angular/core": "^18.2.7",
    "@angular/forms": "^18.2.7",
    "@angular/localize": "^18.2.7",
    "@angular/material": "^16.2.0",
    "@angular/platform-browser": "^18.2.7",
    "@angular/platform-browser-dynamic": "^18.2.7",
    "@angular/router": "^18.2.7",
    "@ngrx/effects": "^17.2.0",
    "@ngrx/store": "^17.2.0",
    "angular-calendar": "^0.31.1",
    "core-js": "^2.6.5",
    "date-fns": "^1.30.1",
    "font-awesome": "^4.7.0",
    "request-promise": "^4.2.5",
    "rxjs": "~6.5.5",
    "rxjs-compat": "^6.5.2",
    "tslib": "^2.0.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.7",
    "@angular/cli": "^18.2.7",
    "@angular/compiler-cli": "^18.2.7",
    "@angular/language-service": "^18.2.7",
    "@babel/compat-data": "7.8.0",
    "@ngrx/schematics": "^17.2.0",
    "@ngrx/store-devtools": "^17.2.0",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "^2.0.6",
    "@types/node": "^12.11.1",
    "@types/request-promise": "^4.1.44",
    "codelyzer": "^6.0.0",
    "electron": "^32.1.2",
    "electron-packager": "^13.1.1",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "protractor": "~7.0.0",
    "ts-node": "~7.0.0",
    "tslint": "~6.1.0",
    "typescript": "~5.5.4"
  }
}