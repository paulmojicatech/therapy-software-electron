{
  "name": "therapy-software",
  "version": "2.0.0",
  "author": "Paul Mojica Technologies",
  "description": "Therapy Software - manage a clinician's case load",
  "private": true,
  "main": "dist/electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write \"{src,electron}/**/*.{ts,html,scss}\"",
    "build:electron": "tsc -p electron/tsconfig.json",
    "electron": "npm run build && npm run build:electron && electron .",
    "electron:dev": "npm run build:electron && concurrently -k -n ng,electron \"ng serve\" \"wait-on http://localhost:4200 && cross-env ELECTRON_START_URL=http://localhost:4200 electron .\"",
    "package": "npm run build && npm run build:electron && electron-builder",
    "package:mac": "npm run build && npm run build:electron && electron-builder --mac",
    "package:win": "npm run build && npm run build:electron && electron-builder --win"
  },
  "build": {
    "appId": "com.paulmojicatech.therapysoftware",
    "productName": "Therapy Software",
    "directories": {
      "output": "release-builds"
    },
    "files": [
      "dist/electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@ngrx/operators": "^22.0.0",
    "@ngrx/signals": "^22.0.0",
    "@types/node": "^24.19.2",
    "angular-calendar": "^0.32.2",
    "angular-draggable-droppable": "^9.0.1",
    "angular-resizable-element": "^8.0.3",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "jsdom": "^30.0.0",
    "material-symbols": "^0.48.1",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.0.0"
  }
}
